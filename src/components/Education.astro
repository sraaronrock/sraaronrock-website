---
export interface EducationItem {
  degree: string;
  institution: string;
  period: string;
  location: string;
}

export interface Props {
  items: EducationItem[];
}

const { items } = Astro.props;
---

<section id="education" class="py-10">
  <div class="flex items-center justify-between mb-8">
    <h2 class="section-title text-white">
      Education
    </h2>
  </div>

  <div class="space-y-4 animate-stagger">
    {items.map((item) => (
      <div class="card group">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1">
          <div>
            <h3 class="font-mono font-bold text-base text-white group-hover:text-white/80 transition-colors duration-300">
              {item.degree}
            </h3>
            <p class="font-mono text-sm text-text-secondary mt-1">{item.institution}</p>
          </div>
          <div class="sm:text-right shrink-0">
            <p class="font-mono text-xs text-text-secondary">{item.period}</p>
            <p class="font-mono text-xs text-text-secondary/60">{item.location}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

---
export interface Props {
  name: string;
  subtitle: string;
  imageUrl: string;
  email: string;
  linkedinUrl: string;
  githubUrl: string;
  location: string;
}

const { name, subtitle, imageUrl, email, linkedinUrl, githubUrl, location } = Astro.props;
---

<section id="hero" class="py-12 md:py-16">
  <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 md:gap-8">
    <div class="relative group">
      <div class="absolute -inset-1 rounded-full bg-white/10 blur-md group-hover:bg-white/20 transition-all duration-500"></div>
      <img
        src={imageUrl}
        alt={name}
        class="relative w-28 h-28 md:w-36 md:h-36 rounded-full object-cover border-2 border-white/20 group-hover:border-white/40 transition-all duration-500"
        loading="eager"
      />
    </div>
    <div class="text-center sm:text-left">
      <h1 class="font-mono text-3xl md:text-5xl font-bold tracking-tight text-white">
        {name}
      </h1>
      <p class="mt-3 text-lg md:text-xl text-text-secondary font-mono">
        {subtitle}
      </p>
      <div class="mt-4 flex flex-wrap items-center justify-center sm:justify-start gap-3 text-sm text-text-secondary">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-white/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          {location}
        </span>
        <span class="text-white/20">|</span>
        <a href={`mailto:${email}`} class="flex items-center gap-1.5 hover:text-white transition-colors">
          <svg class="w-4 h-4 text-white/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          {email}
        </a>
      </div>
    </div>
  </div>
</section>

---
export interface CertificationItem {
  name: string;
  issuer: string;
  date: string;
}

export interface Props {
  items: CertificationItem[];
}

const { items } = Astro.props;
---

<section id="certifications" class="py-10">
  <div class="flex items-center justify-between mb-8">
    <h2 class="section-title text-white">
      Certifications
    </h2>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 animate-stagger">
    {items.map((item) => (
      <div class="card group relative overflow-hidden">
        <div class="absolute top-0 left-0 w-1 h-full bg-white/20 group-hover:bg-white/50 transition-colors duration-300"></div>
        <div class="pl-3">
          <h3 class="font-mono font-bold text-sm text-white group-hover:text-white/80 transition-colors duration-300 leading-snug">
            {item.name}
          </h3>
          <p class="font-mono text-xs text-text-secondary mt-2">{item.issuer}</p>
          <p class="font-mono text-xs text-text-secondary/60 mt-1">{item.date}</p>
        </div>
      </div>
    ))}
  </div>
</section>
